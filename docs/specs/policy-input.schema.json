{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aip.internal/policy-input.schema.json",
  "title": "PDP 输入（architecture.md 4.4）",
  "type": "object",
  "properties": {
    "principal": {
      "type": "object",
      "properties": {
        "identity_kind": {
          "enum": [
            "user",
            "app"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_id": {
          "type": "string"
        },
        "clearance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_profile_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "identity_kind",
        "company_id",
        "clearance",
        "client_id"
      ]
    },
    "facts": {
      "type": "object",
      "properties": {
        "app_grant": {
          "type": "boolean"
        },
        "user_grant_required": {
          "type": "boolean"
        },
        "user_grant": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "within_ceiling": {
          "type": "boolean"
        },
        "scope_check": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "org_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "in_scope": {
                "type": "boolean"
              }
            },
            "required": [
              "in_scope"
            ]
          }
        }
      },
      "required": [
        "app_grant",
        "within_ceiling",
        "scope_check"
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "classification": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "risk": {
          "enum": [
            "read",
            "write",
            "danger"
          ]
        },
        "release_status": {
          "enum": [
            "canary",
            "active",
            "deprecated",
            "suspended",
            "retired"
          ]
        },
        "confirm_policy": {
          "enum": [
            "auto",
            "user_confirm",
            "approval"
          ]
        },
        "app_identity_allowed": {
          "type": "boolean"
        },
        "transport_exception": {
          "type": "boolean"
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "capability_id",
        "version",
        "classification",
        "risk",
        "release_status",
        "confirm_policy"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "env": {
          "enum": [
            "test",
            "staging",
            "prod"
          ]
        },
        "channel": {
          "enum": [
            "beta",
            "stable"
          ]
        },
        "exposure": {
          "enum": [
            "rest",
            "mcp",
            "a2a",
            "internal"
          ]
        },
        "time_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "env",
        "channel",
        "exposure"
      ]
    }
  },
  "required": [
    "principal",
    "facts",
    "resource",
    "context"
  ],
  "additionalProperties": false
}
