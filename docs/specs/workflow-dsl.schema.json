{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aip.internal/workflow-dsl.schema.json",
  "title": "Workflow DSL（architecture.md 6.3）",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "trigger": {
      "enum": [
        "api",
        "schedule",
        "event"
      ],
      "default": "api"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_llm_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        }
      },
      "required": [
        "max_steps",
        "max_llm_calls",
        "timeout_s"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "required": [
    "name",
    "version",
    "budget",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "tool",
            "llm",
            "condition",
            "parallel",
            "loop",
            "human_task",
            "sub_workflow",
            "wait",
            "end"
          ]
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "compensation": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "irreversible": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "llm"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "model_profile",
              "prompt",
              "output_schema"
            ],
            "properties": {
              "model_profile": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "prompt": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "output_schema": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "expr",
              "then",
              "else"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "loop"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "max_iterations",
              "body"
            ],
            "properties": {
              "max_iterations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "human_task"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "kind",
              "assignee"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "confirm",
                  "approve",
                  "input"
                ]
              },
              "timeout_s": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sub_workflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "parallel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "branches"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "seconds"
            ]
          }
        }
      ]
    }
  }
}
