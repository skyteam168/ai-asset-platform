{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aip.internal/workflow-dsl.schema.json",
  "title": "Workflow DSL（architecture.md 6.3）",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "data_classification": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "input_schema": {
      "type": "object"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "output_schema": {
      "type": "object"
    },
    "trigger": {
      "enum": [
        "api",
        "schedule",
        "event"
      ],
      "default": "api"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_llm_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        }
      },
      "required": [
        "max_steps",
        "max_llm_calls",
        "timeout_s"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "required": [
    "name",
    "version",
    "budget",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "tool",
            "llm",
            "condition",
            "parallel",
            "loop",
            "human_task",
            "sub_workflow",
            "wait",
            "end"
          ]
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "args": {
                "type": "object",
                "description": "参数映射；以 $ 开头的字符串是数据路径，如 $input.po_no"
              },
              "compensation": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "compensation_args": {
                "type": "object"
              },
              "irreversible": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "llm"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "model_profile",
              "prompt",
              "output_schema"
            ],
            "properties": {
              "model_profile": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "prompt": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "output_schema": {
                "type": "string",
                "description": "引用顶层 schemas 中的名字"
              },
              "inputs": {
                "type": "object"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "then"
                  ]
                },
                {
                  "required": [
                    "else"
                  ]
                },
                {
                  "required": [
                    "on_timeout"
                  ]
                },
                {
                  "required": [
                    "on_reject"
                  ]
                },
                {
                  "required": [
                    "branches"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "expr",
              "then",
              "else"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "loop"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "max_iterations",
              "body",
              "next"
            ],
            "properties": {
              "max_iterations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "body": {
                "type": "string",
                "description": "循环体入口节点；体结束时 next 指回本 loop 节点"
              },
              "while": {
                "type": "string",
                "description": "可选 CEL；缺省则执行至 max_iterations"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "human_task"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "kind",
              "assignee"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "confirm",
                  "approve",
                  "input"
                ]
              },
              "assignee": {
                "type": "string",
                "pattern": "^(initiator|user:[0-9a-f-]{36}|role:[a-z_]+@([A-Za-z0-9_.-]+|\\$input\\.[A-Za-z0-9_.]+|org_of\\(input\\.[A-Za-z0-9_.]+\\)))$"
              },
              "summary": {
                "type": "string",
                "maxLength": 500
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1
              },
              "on_timeout": {
                "type": "string"
              },
              "on_reject": {
                "type": "string"
              },
              "escalate_to": {
                "type": "string",
                "description": "超时后升级到的处理人（与 assignee 同写法）；优先于 on_timeout",
                "pattern": "^(initiator|user:[0-9a-f-]{36}|role:[a-z_]+@([A-Za-z0-9_.-]+|\\$input\\.[A-Za-z0-9_.]+|org_of\\(input\\.[A-Za-z0-9_.]+\\)))$"
              },
              "input_schema": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sub_workflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref",
              "next"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
              },
              "args": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "parallel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "branches",
              "next"
            ],
            "properties": {
              "branches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "各分支入口；分支结束时 next 指回本 parallel 节点汇合"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "seconds"
            ],
            "properties": {
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
