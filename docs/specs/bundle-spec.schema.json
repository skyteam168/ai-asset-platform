{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aip.internal/bundle-spec.schema.json",
  "title": "套件 Spec（architecture.md 8.7、10.1）",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "description": "套件名，对应 MCP 路径 /mcp/bundles/{name}"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "description": "可选；缺省用资产 name 作为发布快照 capability_id"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.]+@\\d+\\.\\d+\\.\\d+$"
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "description": "成员 Tool 引用，格式 capability_id@semver"
    }
  },
  "required": [
    "name",
    "description",
    "tools"
  ],
  "additionalProperties": false
}
